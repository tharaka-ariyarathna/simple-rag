DOCS_DIR=C:/path/to/your/documents
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag

# Answering LLMs, tried in this order (groq, openrouter, ollama, gemini). Startup fails if a listed provider's key is missing.
ANSWER_LLM_CHAIN=groq,openrouter,ollama
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
# Synthetic question generation (default: ollama). openrouter,ollama = OpenRouter first, the local model when it is capped
# QUESTION_LLM_CHAIN=openrouter,ollama
# Optional model overrides (defaults are in src/rag/constants.py)
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OLLAMA_MODEL=llama3.2:3b
# Reranker (default BAAI/bge-reranker-base, about 1 GB, downloaded on first start). none = hybrid search order only
# RERANKER_MODEL=none
# Only needed when ANSWER_LLM_CHAIN includes gemini
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.8-flash

EVAL_DATASET_DIR=C:/path/to/dataset-with-jds-and-labels

# Integration tests only: a separate database ending in _test (its schema is dropped and rebuilt on every run)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_test
